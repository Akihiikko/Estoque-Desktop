<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="450.0" prefWidth="700.0" styleClass="tabela" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amanda.estoque.Controller.EstoqueController">
   <top>
      <VBox prefHeight="117.0" prefWidth="700.0" styleClass="tabela" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <Label prefHeight="47.0" prefWidth="296.0" text="Produtos em Estoque 📦" textFill="WHITE">
               <font>
                  <Font name="Lucida Calligraphy Italic" size="21.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" stylesheets="@style.css">
               <children>
                  <TextField fx:id="campoBusca" prefHeight="27.0" prefWidth="239.0" promptText="Digite o ID do produto" styleClass="campos-login" stylesheets="@style.css">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </TextField>
                  <Button fx:id="btnAdicionarProduto" mnemonicParsing="false" onAction="#adicionarProduto" styleClass="menu" stylesheets="@style.css" text="+ Adicionar">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="btnEditar" layoutX="159.0" layoutY="10.0" mnemonicParsing="false" onAction="#editarProduto" prefHeight="25.0" prefWidth="69.0" styleClass="menu" stylesheets="@style.css" text="Editar">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="btnRemoverProduto" layoutX="211.0" layoutY="10.0" mnemonicParsing="false" onAction="#removerProduto" styleClass="menu" text="- Remover">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="btnVoltarMenu" layoutX="263.0" layoutY="10.0" mnemonicParsing="false" onAction="#aoVoltarMenu" prefHeight="25.0" prefWidth="70.0" styleClass="menu" text="Voltar" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="50.0" right="30.0" top="25.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabelaProdutos" prefHeight="326.0" prefWidth="644.0" styleClass="tabela" stylesheets="@style.css" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colunaId" prefWidth="75.0" text="ID"/>
          <TableColumn fx:id="colunaNome" prefWidth="186.0" text="Nome" />
            <TableColumn fx:id="colunaCategoria" prefWidth="130.0" text="Categoria" />
            <TableColumn fx:id="colunaQuantidade" minWidth="0.0" prefWidth="116.0" text="Quantidade" />
            <TableColumn fx:id="colunaPreco" prefWidth="132.0" text="Preço (R$)" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="15.0" left="30.0" right="30.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
