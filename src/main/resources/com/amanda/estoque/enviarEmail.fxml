<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" styleClass="menu" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amanda.estoque.Controller.EnviarEmailController">
    <children>
        <Label styleClass="titulo-recuperacao" text="Recuperação de Senha" />
        <Label alignment="CENTER" layoutX="100.0" layoutY="127.0" prefHeight="42.0" prefWidth="361.0" styleClass="texto-email-recuperacao" text="Informe seu email para receber o código de verificaçao" textAlignment="CENTER" wrapText="true">
            <font>
                <Font size="10.0" />
            </font>
        </Label>
        <TextField fx:id="emailRecuperacao" prefHeight="37.0" prefWidth="340.0" promptText="Email de recuperação">
            <font>
                <Font size="18.0" />
            </font>
        </TextField>
        <Label fx:id="emailNaoCadastrado" layoutX="100.0" layoutY="93.0" styleClass="texto-erro" text="Email não cadastrado.Tente Novamente!" textFill="#c60303" visible="false">
            <VBox.margin>
                <Insets top="5.0" />
            </VBox.margin>
            <font>
                <Font name="System Italic" size="8.0" />
            </font>
        </Label>
        <Button mnemonicParsing="false" onAction="#aoValidarEmail" prefHeight="30.0" prefWidth="140.0" styleClass="botao" text="Enviar">
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
        </Button>
    </children>
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
</VBox>
